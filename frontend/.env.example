# frontend/.env.example
# URL base del backend FastAPI (sin barra final).
# Desarrollo local:
VITE_API_URL=http://localhost:8000
# Producción (configúrala en Vercel > Settings > Environment Variables):
# VITE_API_URL=https://tu-backend.vercel.app

# Ruta pública de diagnóstico /test. Está activa por defecto; ponla en "false"
# para ocultarla en producción cuando termines las pruebas.
# VITE_HABILITAR_TEST=false