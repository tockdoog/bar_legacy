# Ruta: backend/.env.example
# Plantilla de variables de entorno. Este archivo SÍ se sube a git (a diferencia
# de .env, que nunca debe subirse). Para desarrollo local, cópialo como ".env"
# dentro de backend/ y cambia cada valor de ejemplo por tus propios datos.
# En Vercel NO se usa un archivo: cada variable se define en
# Settings > Environment Variables del proyecto.
#
# IMPORTANTE: los nombres deben coincidir EXACTO con los campos de app/config.py.
# Una variable mal escrita en .env detiene el arranque (extra="forbid").

# --- Entorno de ejecución: "desarrollo" o "produccion" (en Vercel: produccion) ---
ENTORNO=desarrollo

# --- Seguridad de tokens JWT ---
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_esta_clave_por_una_generada_de_forma_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Base de datos ---
# Local: SQLite. Vercel: cadena de Neon con "-pooler" en el host, por ejemplo
# postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./negocio.db

# --- Orígenes permitidos para CORS (separados por coma, sin "*" y sin "/" final) ---
# Local: el frontend de Vite. Vercel: https://tu-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173

# --- Usuario administrador inicial (en producción: contraseña real de 10+ caracteres) ---
ADMIN_USUARIO=admin
ADMIN_CORREO=admin@negocio.com
ADMIN_CONTRASENA=CambiarEsta123!
ADMIN_NOMBRE=Administrador Principal

# --- Imágenes de productos (se guardan en la base de datos) ---
CARPETA_IMAGENES_PRODUCTOS=uploads/productos
# Máximo 4194304 (4 MB): Vercel rechaza peticiones de más de 4,5 MB.
TAMANO_MAXIMO_IMAGEN_BYTES=4194304
LADO_MAXIMO_IMAGEN_PX=800

# --- Imágenes de las cuentas/medios de pago (QR de Nequi, Bancolombia, etc.) ---
CARPETA_IMAGENES_CUENTAS_PROVEEDOR=imagenes/cuentas

# --- Suscripción mensual y bloqueo automático (valor en pesos colombianos, COP) ---
DIAS_SUSCRIPCION=30
CLAVE_MAESTRA_DESBLOQUEO=cambiar_por_una_clave_segura_de_desbloqueo
VALOR_SUSCRIPCION_MENSUAL=150000
UMBRAL_INTENTOS_DESBLOQUEO=5
MINUTOS_BLOQUEO_INTENTOS_DESBLOQUEO=15

# --- Bloqueo colaborativo de mesas (segundos) ---
TIEMPO_HEARTBEAT_SEGUNDOS=20
TIEMPO_EXPIRACION_BLOQUEO_SEGUNDOS=60

# --- Monitoreo / logs internos ---
CARPETA_LOGS=~/logs
NIVEL_LOG=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=10
CLAVE_ACCESO_LOGS=clave_segura_para_ver_los_logs

# --- Datos del negocio (aparecen en el encabezado de la factura de venta) ---
NOMBRE_NEGOCIO=Mi Negocio
NIT_NEGOCIO=NIT 900.000.000-0
DIRECCION_NEGOCIO=Calle 00 # 00-00, Bogotá
TELEFONO_NEGOCIO=(601) 000 0000

# --- Envío de facturas por correo (si SMTP_HOST queda vacío, la función se deshabilita) ---
# Ejemplo con Gmail: smtp.gmail.com, puerto 587 y una "contraseña de aplicación".
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=facturacion@minegocio.com
SMTP_USA_TLS=true