# Ruta: backend/.env.example
# Plantilla de variables de entorno. Este archivo SÍ se sube a git (a diferencia
# de .env, que nunca debe subirse). Copia este contenido en un archivo ".env"
# dentro de backend/ y reemplaza cada valor de ejemplo por tus propios datos.

# --- Entorno de ejecución: "desarrollo" o "produccion" ---
ENTORNO=desarrollo

# --- Seguridad de tokens JWT ---
# Generar con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar_esta_clave_por_una_generada_de_forma_segura
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Base de datos ---
DATABASE_URL=sqlite:///./negocio.db

# --- Orígenes permitidos para CORS (separados por coma, sin usar "*") ---
CORS_ORIGINS=https://localhost:5443

# --- Usuario administrador inicial ---
ADMIN_USUARIO=admin
ADMIN_CORREO=admin@negocio.com
ADMIN_CONTRASENA=CambiarEsta123!
ADMIN_NOMBRE=Administrador Principal

# --- Imágenes de productos ---
CARPETA_IMAGENES_PRODUCTOS=uploads/productos
TAMANO_MAXIMO_IMAGEN_BYTES=5242880
LADO_MAXIMO_IMAGEN_PX=800

# --- Imágenes de las cuentas/medios de pago (QR de Nequi, Bancolombia, etc.) ---
# IMPORTANTE: el nombre de esta variable debe coincidir EXACTO con el campo
# CARPETA_IMAGENES_CUENTAS_PROVEEDOR declarado en backend/app/config.py.
# Si el nombre no coincide, Pydantic rechaza el arranque completo del
# backend (model_config tiene extra="forbid" a propósito, por seguridad,
# para detectar variables mal escritas en vez de ignorarlas en silencio).
CARPETA_IMAGENES_CUENTAS_PROVEEDOR=imagenes/cuentas

# --- Suscripción mensual y bloqueo automático del sistema ---
DIAS_SUSCRIPCION=30
CLAVE_MAESTRA_DESBLOQUEO=cambiar_por_una_clave_segura_de_desbloqueo
VALOR_SUSCRIPCION_MENSUAL=150000
UMBRAL_INTENTOS_DESBLOQUEO=5
MINUTOS_BLOQUEO_INTENTOS_DESBLOQUEO=15

# --- Módulo de monitoreo / logs internos (carpeta ~/logs) ---
CARPETA_LOGS=~/logs
NIVEL_LOG=INFO
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=10
CLAVE_ACCESO_LOGS=clave_segura_para_ver_los_logs

# --- Datos del negocio (aparecen en el encabezado de la factura de venta) ---
NOMBRE_NEGOCIO=Mi Negocio
NIT_NEGOCIO=NIT 900.000.000-0
DIRECCION_NEGOCIO=Calle 00 # 00-00, Bogotá
TELEFONO_NEGOCIO=(601) 000 0000

# --- Envío de facturas por correo electrónico (servidor SMTP) ---
# Si dejas SMTP_HOST vacío, el botón "Enviar por correo" del POS mostrará
# un error indicando que la función no está configurada; el resto del
# sistema sigue funcionando con normalidad.
# Ejemplo con Gmail: usa smtp.gmail.com, puerto 587, y una "contraseña de
# aplicación" (no la contraseña normal de la cuenta).
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CONTRASENA=
SMTP_REMITENTE=facturacion@minegocio.com
SMTP_USA_TLS=true